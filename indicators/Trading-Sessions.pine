//@version=5
indicator("Trading Sessions", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================================================================
// ZONA HORARIA
// ============================================================================

tzMode = input.string("America/New_York", title = "Zona horaria",
     options = ["Exchange", "UTC", "America/New_York", "Europe/London", "Asia/Tokyo", "Europe/Berlin", "America/Argentina/Buenos_Aires"],
     group = "Zona horaria")

tz = tzMode == "Exchange" ? syminfo.timezone : tzMode

// ============================================================================
// SESIONES
// ============================================================================

gAsia = "Asia"
asiaShow = input.bool(true, "Activar", group = gAsia, inline = "a1")
asiaCol  = input.color(#5C6BC0, "", group = gAsia, inline = "a1")
asiaSess = input.session("1900-0400", "Horario", group = gAsia)
asiaTxt  = input.string("ASIA", "Etiqueta", group = gAsia)

gLon = "Londres"
lonShow = input.bool(true, "Activar", group = gLon, inline = "l1")
lonCol  = input.color(#26A69A, "", group = gLon, inline = "l1")
lonSess = input.session("0300-1130", "Horario", group = gLon)
lonTxt  = input.string("LONDON", "Etiqueta", group = gLon)

gLC = "Londres Close"
lcShow = input.bool(true, "Activar", group = gLC, inline = "c1")
lcCol  = input.color(#FFA726, "", group = gLC, inline = "c1")
lcSess = input.session("1000-1200", "Horario", group = gLC)
lcTxt  = input.string("LDN CLOSE", "Etiqueta", group = gLC)

gNY = "Nueva York"
nyShow = input.bool(true, "Activar", group = gNY, inline = "n1")
nyCol  = input.color(#EF5350, "", group = gNY, inline = "n1")
nySess = input.session("0800-1700", "Horario", group = gNY)
nyTxt  = input.string("NEW YORK", "Etiqueta", group = gNY)

// ============================================================================
// ESTILO
// ============================================================================

gS = "Estilo"
maxDays     = input.int(5, "Dias de historial", minval = 1, maxval = 90, group = gS,
     tooltip = "Solo dibuja las sesiones de los ultimos N dias. Menos dias = grafico mas limpio.")
showFill    = input.bool(false, "Rellenar la caja", group = gS)
fillOpacity = input.int(93, "Transparencia del relleno", minval = 70, maxval = 99, group = gS)
borderStyle = input.string("Punteado", "Borde de la caja", options = ["Solido", "Punteado", "Rayado"], group = gS)
showLevels  = input.bool(true, "Proyectar alto y bajo al cerrar", group = gS)
showLabels  = input.bool(true, "Etiquetas", group = gS)
labelChip   = input.bool(false, "Etiqueta con fondo", group = gS,
     tooltip = "Apagado: solo el texto, mas limpio. Encendido: chip de color.")
lblSize     = input.string(size.tiny, "Tamano de etiqueta",
     options = [size.tiny, size.small, size.normal], group = gS)

bStyle = borderStyle == "Solido" ? line.style_solid : borderStyle == "Punteado" ? line.style_dotted : line.style_dashed

var color cNone = na

// Limita el dibujo a las ultimas N jornadas para no saturar el grafico.
inWindow = (timenow - time) <= maxDays * 86400000.0

// ============================================================================
// DETECCION DE SESION
// ============================================================================
// time() devuelve na fuera de la sesion. Maneja cruces de medianoche, dias no
// operativos y horario de verano de forma nativa.

inSession(sess) =>
    not na(time(timeframe.period, sess, tz))

asiaOn = asiaShow and inSession(asiaSess)
lonOn  = lonShow  and inSession(lonSess)
lcOn   = lcShow   and inSession(lcSess)
nyOn   = nyShow   and inSession(nySess)

// ============================================================================
// DIBUJO DE UNA SESION
// ============================================================================
// Durante la sesion se dibuja solo la caja: su borde superior es el alto y el
// inferior el bajo, asi que ya marca el rango. Recien al cerrar la sesion se
// crean las lineas, que proyectan esos dos niveles hacia adelante.
//
// Cada llamada mantiene su propio estado: las variables `var` dentro de una
// funcion son independientes por cada lugar desde donde se la llama.

drawSession(active, col, name) =>
    var box   bx     = na
    var line  hiLn   = na
    var line  loLn   = na
    var label lbl    = na
    var float hi     = na
    var float lo     = na
    var int   xStart = na

    starting = active and not active[1]
    running  = active and active[1]
    ending   = not active and active[1]

    if starting
        hi := high
        lo := low
        xStart := bar_index

        if inWindow
            bx := box.new(bar_index, hi, bar_index, lo, border_color = col, border_width = 1,
                 border_style = bStyle, bgcolor = showFill ? color.new(col, fillOpacity) : cNone)

            if showLabels
                lbl := label.new(bar_index, hi, name, style = labelChip ? label.style_label_down : label.style_none,
                     color = labelChip ? color.new(col, 10) : cNone,
                     textcolor = labelChip ? color.white : col, size = lblSize)

    else if running
        hi := math.max(hi, high)
        lo := math.min(lo, low)

        if not na(bx)
            box.set_top(bx, hi)
            box.set_bottom(bx, lo)
            box.set_right(bx, bar_index)

        if not na(lbl)
            label.set_y(lbl, hi)

    else
        if ending and showLevels and not na(bx)
            hiLn := line.new(xStart, hi, bar_index, hi, color = col, width = 1, style = line.style_dotted)
            loLn := line.new(xStart, lo, bar_index, lo, color = col, width = 1, style = line.style_dotted)

        // Los niveles siguen hacia adelante hasta que arranque la proxima
        // sesion, momento en el que se crean lineas nuevas y estas se congelan.
        if not na(hiLn)
            line.set_x2(hiLn, bar_index)
            line.set_x2(loLn, bar_index)

    hi

drawSession(asiaOn, asiaCol, asiaTxt)
drawSession(lonOn,  lonCol,  lonTxt)
drawSession(lcOn,   lcCol,   lcTxt)
drawSession(nyOn,   nyCol,   nyTxt)

// ============================================================================
// ALERTAS
// ============================================================================
// alertcondition() requiere scope global y mensaje constante.

alertcondition(asiaOn and not asiaOn[1], "Apertura Asia",          "Comenzo la sesion de Asia")
alertcondition(lonOn  and not lonOn[1],  "Apertura Londres",       "Comenzo la sesion de Londres")
alertcondition(lcOn   and not lcOn[1],   "Apertura Londres Close", "Comenzo la ventana de Londres Close")
alertcondition(nyOn   and not nyOn[1],   "Apertura Nueva York",    "Comenzo la sesion de Nueva York")
