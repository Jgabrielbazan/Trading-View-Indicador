//@version=5
indicator("Trading Sessions", overlay = true, max_boxes_count = 500, max_lines_count = 500)

// ============================================================================
// ZONA HORARIA
// ============================================================================
// "Exchange" usa la zona horaria del grafico (syminfo.timezone).
// Las demas son zonas IANA: los horarios de abajo se interpretan en esa zona.

tzMode = input.string("America/New_York", title = "Zona horaria",
     options = ["Exchange", "UTC", "America/New_York", "Europe/London", "Asia/Tokyo", "Europe/Berlin", "America/Argentina/Buenos_Aires"],
     group = "Zona horaria")

tz = tzMode == "Exchange" ? syminfo.timezone : tzMode

// ============================================================================
// SESIONES
// ============================================================================
// Horarios por defecto expresados en hora de Nueva York.

gAsia = "Asia"
asiaShow   = input.bool(true, "Activar", group = gAsia)
asiaSess   = input.session("1900-0400", "Horario", group = gAsia)
asiaBorder = input.color(color.new(#2962FF, 0),  "Borde / lineas", group = gAsia, inline = "asiaC")
asiaFill   = input.color(color.new(#2962FF, 88), "Relleno",        group = gAsia, inline = "asiaC")
asiaTxt    = input.string("ASIA", "Etiqueta", group = gAsia)

gLon = "Londres"
lonShow   = input.bool(true, "Activar", group = gLon)
lonSess   = input.session("0300-1130", "Horario", group = gLon)
lonBorder = input.color(color.new(#FF9800, 0),  "Borde / lineas", group = gLon, inline = "lonC")
lonFill   = input.color(color.new(#FF9800, 88), "Relleno",        group = gLon, inline = "lonC")
lonTxt    = input.string("LONDON", "Etiqueta", group = gLon)

gLC = "Londres Close"
lcShow   = input.bool(true, "Activar", group = gLC)
lcSess   = input.session("1000-1200", "Horario", group = gLC)
lcBorder = input.color(color.new(#FFEB3B, 0),  "Borde / lineas", group = gLC, inline = "lcC")
lcFill   = input.color(color.new(#FFEB3B, 88), "Relleno",        group = gLC, inline = "lcC")
lcTxt    = input.string("LONDON CLOSE", "Etiqueta", group = gLC)

gNY = "Nueva York"
nyShow   = input.bool(true, "Activar", group = gNY)
nySess   = input.session("0800-1700", "Horario", group = gNY)
nyBorder = input.color(color.new(#F23645, 0),  "Borde / lineas", group = gNY, inline = "nyC")
nyFill   = input.color(color.new(#F23645, 88), "Relleno",        group = gNY, inline = "nyC")
nyTxt    = input.string("NEW YORK", "Etiqueta", group = gNY)

// ============================================================================
// VISUALIZACION
// ============================================================================

gDisp = "Visualizacion"
showBox    = input.bool(true,  "Caja del rango (alto/bajo)", group = gDisp)
showLines  = input.bool(true,  "Lineas de alto y bajo",      group = gDisp)
extendLine = input.bool(true,  "Extender lineas al cerrar la sesion", group = gDisp)
showLabels = input.bool(true,  "Etiquetas de sesion",        group = gDisp)
showBg     = input.bool(false, "Fondo coloreado",            group = gDisp)
lineWidth  = input.int(1, "Grosor de linea", minval = 1, maxval = 5, group = gDisp)
lblSize    = input.string(size.small, "Tamano de etiqueta",
     options = [size.tiny, size.small, size.normal, size.large], group = gDisp)

// ============================================================================
// DETECCION DE SESION
// ============================================================================
// time() devuelve na fuera de la sesion. Maneja cruces de medianoche y zona
// horaria de forma nativa, por eso no hace falta calcular offsets a mano.

inSession(sess) =>
    not na(time(timeframe.period, sess, tz))

asiaOn = asiaShow and inSession(asiaSess)
lonOn  = lonShow  and inSession(lonSess)
lcOn   = lcShow   and inSession(lcSess)
nyOn   = nyShow   and inSession(nySess)

// ============================================================================
// DIBUJO DE UNA SESION
// ============================================================================
// Cada llamada a esta funcion mantiene su propio estado: en Pine, las variables
// declaradas con `var` dentro de una funcion son independientes por cada lugar
// desde donde se la llama.

drawSession(active, cBorder, cFill, name) =>
    var box   bx    = na
    var line  hiLn  = na
    var line  loLn  = na
    var label lbl   = na
    var float hi    = na
    var float lo    = na
    var int   xStart = na

    starting = active and not active[1]
    running  = active and active[1]

    if starting
        hi := high
        lo := low
        xStart := bar_index

        if showBox
            bx := box.new(bar_index, hi, bar_index, lo, border_color = cBorder,
                 border_width = lineWidth, bgcolor = cFill)

        if showLines
            hiLn := line.new(bar_index, hi, bar_index, hi, color = cBorder, width = lineWidth)
            loLn := line.new(bar_index, lo, bar_index, lo, color = cBorder, width = lineWidth)

        if showLabels
            lbl := label.new(bar_index, hi, name, style = label.style_label_down,
                 color = color.new(cBorder, 15), textcolor = color.white, size = lblSize)

    else if running
        hi := math.max(hi, high)
        lo := math.min(lo, low)

        if not na(bx)
            box.set_top(bx, hi)
            box.set_bottom(bx, lo)
            box.set_right(bx, bar_index)

        if not na(hiLn)
            line.set_xy1(hiLn, xStart, hi)
            line.set_xy2(hiLn, bar_index, hi)
            line.set_xy1(loLn, xStart, lo)
            line.set_xy2(loLn, bar_index, lo)

        if not na(lbl)
            label.set_y(lbl, hi)

    else if extendLine and not na(hiLn)
        // Sesion cerrada: el alto y el bajo quedan proyectados hacia adelante
        // hasta que arranque la proxima sesion (ahi se crean lineas nuevas).
        line.set_x2(hiLn, bar_index)
        line.set_x2(loLn, bar_index)

    // Valor de retorno explicito: deja la cadena if/else en posicion de
    // sentencia y evita el chequeo de tipos entre ramas.
    hi

drawSession(asiaOn, asiaBorder, asiaFill, asiaTxt)
drawSession(lonOn,  lonBorder,  lonFill,  lonTxt)
drawSession(lcOn,   lcBorder,   lcFill,   lcTxt)
drawSession(nyOn,   nyBorder,   nyFill,   nyTxt)

// ============================================================================
// FONDO
// ============================================================================
// bgcolor() solo puede llamarse en scope global, por eso se usa un ternario.
// Prioridad: la sesion mas especifica gana cuando hay solapamiento.

var color cNone = na
bgCol = lcOn ? lcFill : lonOn ? lonFill : asiaOn ? asiaFill : nyOn ? nyFill : cNone
bgcolor(showBg ? bgCol : cNone, title = "Fondo de sesion")

// ============================================================================
// ALERTAS
// ============================================================================
// alertcondition() requiere mensaje constante y scope global.

alertcondition(asiaOn and not asiaOn[1], "Apertura Asia",          "Comenzo la sesion de Asia")
alertcondition(lonOn  and not lonOn[1],  "Apertura Londres",       "Comenzo la sesion de Londres")
alertcondition(lcOn   and not lcOn[1],   "Apertura Londres Close", "Comenzo la ventana de Londres Close")
alertcondition(nyOn   and not nyOn[1],   "Apertura Nueva York",    "Comenzo la sesion de Nueva York")
