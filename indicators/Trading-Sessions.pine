//@version=5
indicator("Trading Sessions", overlay=true, max_boxes_count=500, max_lines_count=500)

// ============================================================================
// CONFIGURACION DE SESIONES
// ============================================================================

// Asia Session
asiaColor = input.color(color.new(color.blue, 80), title="Asia Color", group="Colors")
asiaHighLowColor = input.color(color.new(color.blue, 50), title="Asia High/Low Color", group="Colors")
asiaLabel = input.string("ASIA", title="Asia Label", group="Labels")

// London Session
londonColor = input.color(color.new(color.orange, 80), title="London Color", group="Colors")
londonHighLowColor = input.color(color.new(color.orange, 50), title="London High/Low Color", group="Colors")
londonLabel = input.string("LONDON", title="London Label", group="Labels")

// London Close Session
londonCloseColor = input.color(color.new(color.yellow, 80), title="London Close Color", group="Colors")
londonCloseHighLowColor = input.color(color.new(color.yellow, 50), title="London Close High/Low Color", group="Colors")
londonCloseLabel = input.string("LONDON CLOSE", title="London Close Label", group="Labels")

// New York Session
nyColor = input.color(color.new(color.red, 80), title="New York Color", group="Colors")
nyHighLowColor = input.color(color.new(color.red, 50), title="New York High/Low Color", group="Colors")
nyLabel = input.string("NEW YORK", title="New York Label", group="Labels")

// Configuracion de Zona Horaria
timezoneMode = input.string("UTC", options=["UTC", "EST", "EDT", "GMT", "CET", "CEST", "Custom"], title="Timezone", group="Timezone")
customOffset = input.float(0, minval=-12, maxval=12, step=0.5, title="Custom Timezone Offset", group="Timezone")

// Configuracion General
showSessionLabels = input.bool(true, title="Show Session Labels", group="Display")
showSessionBox = input.bool(true, title="Show Session Box", group="Display")
showHighLow = input.bool(true, title="Show High/Low Ranges", group="Display")
highLowWidth = input.int(2, minval=1, maxval=5, title="High/Low Line Width", group="Display")
labelSize = input.string(size.small, options=[size.tiny, size.small, size.normal, size.large, size.huge], title="Label Size", group="Display")
showTimezoneLabel = input.bool(true, title="Show Timezone Info", group="Display")

// ============================================================================
// CALCULAR OFFSET DE ZONA HORARIA
// ============================================================================

getTimezoneOffset() =>
    if timezoneMode == "UTC"
        0
    else if timezoneMode == "EST"
        -5
    else if timezoneMode == "EDT"
        -4
    else if timezoneMode == "GMT"
        0
    else if timezoneMode == "CET"
        1
    else if timezoneMode == "CEST"
        2
    else if timezoneMode == "Custom"
        customOffset
    else
        0

tzOffset = getTimezoneOffset()
adjustedHour = (hour + tzOffset + 24) % 24

// ============================================================================
// VARIABLES PARA TRACKING DE RANGOS
// ============================================================================

var asiaSessionHigh = high
var asiaSessionLow = low
var londonSessionHigh = high
var londonSessionLow = low
var londonCloseSessionHigh = high
var londonCloseSessionLow = low
var nySessionHigh = high
var nySessionLow = low

// ============================================================================
// FUNCIONES DE SESION
// ============================================================================

isAsiaSession() =>
    adjustedHour >= 22 or adjustedHour < 6

isLondonSession() =>
    adjustedHour >= 7 and adjustedHour < 15

isLondonCloseSession() =>
    adjustedHour >= 15 and adjustedHour < 17

isNYSession() =>
    adjustedHour >= 13 and adjustedHour < 21

getCurrentSessionColor() =>
    if isNYSession()
        nyColor
    else if isLondonCloseSession()
        londonCloseColor
    else if isLondonSession()
        londonColor
    else if isAsiaSession()
        asiaColor
    else
        color.new(color.gray, 90)

getCurrentSessionLabel() =>
    if isNYSession()
        nyLabel
    else if isLondonCloseSession()
        londonCloseLabel
    else if isLondonSession()
        londonLabel
    else if isAsiaSession()
        asiaLabel
    else
        "OFF HOURS"

// ============================================================================
// ACTUALIZAR HIGH/LOW DE CADA SESION
// ============================================================================

if isAsiaSession()
    asiaSessionHigh := math.max(asiaSessionHigh, high)
    asiaSessionLow := math.min(asiaSessionLow, low)
else
    asiaSessionHigh := high
    asiaSessionLow := low

if isLondonSession()
    londonSessionHigh := math.max(londonSessionHigh, high)
    londonSessionLow := math.min(londonSessionLow, low)
else
    londonSessionHigh := high
    londonSessionLow := low

if isLondonCloseSession()
    londonCloseSessionHigh := math.max(londonCloseSessionHigh, high)
    londonCloseSessionLow := math.min(londonCloseSessionLow, low)
else
    londonCloseSessionHigh := high
    londonCloseSessionLow := low

if isNYSession()
    nySessionHigh := math.max(nySessionHigh, high)
    nySessionLow := math.min(nySessionLow, low)
else
    nySessionHigh := high
    nySessionLow := low

// ============================================================================
// DIBUJA BACKGROUND
// ============================================================================

if showSessionBox
    bgcolor(getCurrentSessionColor(), editable=false)

// ============================================================================
// DIBUJA CAJAS DE RANGO Y LINEAS HIGH/LOW
// ============================================================================

if showHighLow
    if isAsiaSession() and not isAsiaSession()[1]
        box.new(bar_index, asiaSessionHigh, bar_index, asiaSessionLow, border_color=asiaHighLowColor, bgcolor=color.new(asiaHighLowColor, 95), border_width=highLowWidth)

    if isLondonSession() and not isLondonSession()[1]
        box.new(bar_index, londonSessionHigh, bar_index, londonSessionLow, border_color=londonHighLowColor, bgcolor=color.new(londonHighLowColor, 95), border_width=highLowWidth)

    if isLondonCloseSession() and not isLondonCloseSession()[1]
        box.new(bar_index, londonCloseSessionHigh, bar_index, londonCloseSessionLow, border_color=londonCloseHighLowColor, bgcolor=color.new(londonCloseHighLowColor, 95), border_width=highLowWidth)

    if isNYSession() and not isNYSession()[1]
        box.new(bar_index, nySessionHigh, bar_index, nySessionLow, border_color=nyHighLowColor, bgcolor=color.new(nyHighLowColor, 95), border_width=highLowWidth)

// ============================================================================
// DIBUJA LABELS
// ============================================================================

if showSessionLabels and barstate.islast
    y_position = high

    if isNYSession()
        label.new(bar_index, y_position, nyLabel, xloc=xloc.bar_index, yloc=yloc.above, color=color.new(nyColor, 0), textcolor=color.white, style=label.style_label_down, size=labelSize)
    else if isLondonCloseSession()
        label.new(bar_index, y_position, londonCloseLabel, xloc=xloc.bar_index, yloc=yloc.above, color=color.new(londonCloseColor, 0), textcolor=color.white, style=label.style_label_down, size=labelSize)
    else if isLondonSession()
        label.new(bar_index, y_position, londonLabel, xloc=xloc.bar_index, yloc=yloc.above, color=color.new(londonColor, 0), textcolor=color.white, style=label.style_label_down, size=labelSize)
    else if isAsiaSession()
        label.new(bar_index, y_position, asiaLabel, xloc=xloc.bar_index, yloc=yloc.above, color=color.new(asiaColor, 0), textcolor=color.white, style=label.style_label_down, size=labelSize)

// ============================================================================
// MUESTRA ZONA HORARIA ACTUAL
// ============================================================================

if showTimezoneLabel and barstate.islast
    tzText = "TZ: " + timezoneMode
    label.new(bar_index, low, tzText, xloc=xloc.bar_index, yloc=yloc.below, color=color.new(color.gray, 20), textcolor=color.white, style=label.style_label_up, size=size.tiny)

// ============================================================================
// ALERTS
// ============================================================================

sessionChanged = (isNYSession() and not isNYSession()[1]) or (isLondonCloseSession() and not isLondonCloseSession()[1]) or (isLondonSession() and not isLondonSession()[1]) or (isAsiaSession() and not isAsiaSession()[1])

alertcondition(sessionChanged, title="Session Change Alert", message="Session Changed to: " + getCurrentSessionLabel())
